# ============================================================
# TezBozor Bot — muhit o'zgaruvchilari namunasi
# ============================================================
# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring:
#   - Windows (PowerShell):  Copy-Item .env.example .env
#   - Linux/Mac:             cp .env.example .env
#
# DIQQAT: .env fayli .gitignore'da — uni HECH QACHON commit qilmang.
# ============================================================

# --- MAJBURIY ---

# Telegram bot tokeni (@BotFather'dan olinadi)
BOT_TOKEN=

# Admin Telegram ID raqami (masalan: 123456789).
# O'rnatilmasa, admin huquqlari hech kimga berilmaydi.
ADMIN_ID=

# --- IXTIYORIY ---

# Markaziy kanal (mahsulotlar avtomatik shu yerga post qilinadi), masalan: @TezBozorUz24
CHANNEL_ID=

# Sentry xato-kuzatuvi DSN'i. Bo'sh qoldirilsa — Sentry o'chiq.
# (Ishlatish uchun: pip install sentry-sdk)
SENTRY_DSN=

# Muhit nomi (Sentry uchun): production | staging | development
ENV=production

# --- WEBHOOK (ixtiyoriy, dual-mode) ---
# WEBHOOK_URL o'rnatilsa bot webhook rejimida, aks holda POLLING (default).
# To'liq qo'llanma: WEBHOOK_MIGRATION.md. Bo'sh qoldirsangiz hech narsa o'zgarmaydi.
WEBHOOK_URL=
WEBHOOK_PORT=8443
# WEBHOOK_PATH bo'sh bo'lsa WEBHOOK_URL'ning to'liq yo'lidan olinadi (mas. tg/<secret>)
WEBHOOK_PATH=
# Telegram so'rovini header bilan tasdiqlovchi maxfiy token (tavsiya etiladi)
WEBHOOK_SECRET=

# --- XAVFSIZLIK SARLAVHALARI (webapp) ---
# SECURITY_HSTS=1 — HTTPS majburlash (faqat prod/HTTPS'da; dev-http'ni qulflab qo'ymang).
SECURITY_HSTS=
# SECURITY_CSP — to'liq Content-Security-Policy qatori. Mini App inline-JS ishlatgani uchun
# script-src 'unsafe-inline' KERAK; frame-ancestors Telegram'ni O'CHIRMANG. Tavsiya:
#   default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org;
#   style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self';
#   frame-ancestors https://web.telegram.org https://*.telegram.org
SECURITY_CSP=

# --- MA'LUMOTLAR BAZASI (Faza 0: SQLite -> PostgreSQL ko'chirish) ---
# DB_BACKEND: sqlite (default) | postgres
# O'rnatilmasa yoki 'sqlite' bo'lsa — eski SQLite (marketplace.db) ishlatiladi.
DB_BACKEND=sqlite
# Faqat DB_BACKEND=postgres bo'lganda kerak:
# DATABASE_URL=postgresql://tezbozor:parol@localhost:5432/marketplace

# --- TO'LOV PROVAYDERLARI (monetizatsiya #18: boost / Pro-obuna) ---
# Bo'sh qoldirilsa, provayder "sozlanmagan" deb hisoblanadi (webhook ishlamaydi).
# Bayroqlarni admin panelidan (💰 Monetizatsiya) yoqasiz; kalitlarni shu yerda berasiz.
# Provayder sozlanmagan paytda sinov uchun admin-only "qo'lda tasdiqlash" yo'li bor.
#
# ⚠️ MUHIM — monetizatsiyani JONLI qilish 3 qadam (aks holda sotuvchi to'lay OLMAYDI,
#    faqat admin "qo'lda tasdiqlash" ishlaydi; sotuvchi "To'lov provayderi sozlanmagan"
#    xabarini ko'radi — bu kod xatosi emas, sozlama yetishmasligi):
#    1) Quyidagi kalitlarni TO'LDIRING (kamida bitta provayder: Click YOKI Payme).
#    2) Provayder kabinetida webhook URL'ni ulang (har provayder ostida ko'rsatilgan).
#    3) Admin panel → 💰 Monetizatsiya → tegishli bayroqlarni (boost/Pro/provayder) yoqing.
#    Shundan keyin sotuvchi boost/Pro tugmasi → checkout URL ochiladi → to'lagach
#    webhook to'lovni 'paid' qiladi → boost/obuna avtomatik qo'llanadi.
#
# Click (https://click.uz — Merchant API). Webhook URL: https://<domen>/api/pay/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
#
# Payme (https://payme.uz — Merchant JSON-RPC). Webhook URL: https://<domen>/api/pay/payme
# PAYME_KEY — kassir (kabinet) kaliti; webhook Basic-auth parolini tekshirish uchun.
PAYME_MERCHANT_ID=
PAYME_KEY=
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Payme kabinetidagi "hisob (account)" maydoni nomi (default payment_id). Kabinetda
# boshqacha bo'lsa shu yerda moslang — webhook va checkout shu nomdan foydalanadi.
# PAYME_ACCOUNT_FIELD=payment_id
#
# Paynet (merchant JSON-RPC). Webhook URL: https://<domen>/api/pay/paynet
# Webhook Basic-auth: PAYNET_LOGIN:PAYNET_PASSWORD. Protokol (metod nomlari) Payme'ga
# o'xshash deb taxmin qilingan — Paynet kabinet hujjati bilan TASDIQLANGACH yoqing.
PAYNET_MERCHANT_ID=
PAYNET_LOGIN=
PAYNET_PASSWORD=
# Redirect-checkout bo'lsa (ixtiyoriy): PAYNET_CHECKOUT_URL=https://...
