# ============================================================
# TezBozor Bot — muhit o'zgaruvchilari namunasi
# ============================================================
# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring:
#   - Windows (PowerShell):  Copy-Item .env.example .env
#   - Linux/Mac:             cp .env.example .env
#
# DIQQAT: .env fayli .gitignore'da — uni HECH QACHON commit qilmang.
# ============================================================

# --- MAJBURIY ---

# Telegram bot tokeni (@BotFather'dan olinadi)
BOT_TOKEN=

# Admin Telegram ID raqami (masalan: 123456789).
# O'rnatilmasa, admin huquqlari hech kimga berilmaydi.
ADMIN_ID=

# --- IXTIYORIY ---

# Markaziy kanal (mahsulotlar avtomatik shu yerga post qilinadi), masalan: @TezBozorUz24
CHANNEL_ID=

# Sentry xato-kuzatuvi DSN'i. Bo'sh qoldirilsa — Sentry o'chiq.
# (Ishlatish uchun: pip install sentry-sdk)
SENTRY_DSN=

# Muhit nomi (Sentry uchun): production | staging | development
ENV=production

# --- MA'LUMOTLAR BAZASI (Faza 0: SQLite -> PostgreSQL ko'chirish) ---
# DB_BACKEND: sqlite (default) | postgres
# O'rnatilmasa yoki 'sqlite' bo'lsa — eski SQLite (marketplace.db) ishlatiladi.
DB_BACKEND=sqlite
# Faqat DB_BACKEND=postgres bo'lganda kerak:
# DATABASE_URL=postgresql://tezbozor:parol@localhost:5432/marketplace
